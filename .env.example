# Copy to .env — values from Supabase dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where the public queue page (web/) lives, for a test build before sterncut.ma
# points at it — e.g. https://<project>.pages.dev/q. Unset means https://sterncut.ma/q.
# Never print posters from a build that sets this. The app claims this host's
# /q/<code> links (app.config.js), so a new value needs a new build.
# EXPO_PUBLIC_QUEUE_BASE=
#
# The queue page's host only (Cloudflare Pages variables — never EXPO_PUBLIC_):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, and for a shop's
# link to open the installed app, from `eas credentials`:
# ANDROID_CERT_SHA256=   (the signing certificate's SHA-256; comma-separate several)
# IOS_APP_ID=            (TEAMID.com.sterncut.app)
# Unset, the links simply open the browser.
